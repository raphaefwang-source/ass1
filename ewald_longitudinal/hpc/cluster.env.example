# Copy to hpc/cluster.env and replace every FILL_ME. Nothing here is guessed for your cluster.
# The Slurm scripts refuse to run while any FILL_ME is left.

SLURM_ACCOUNT=FILL_ME            # sbatch --account (project / allocation name)
SLURM_PARTITION=FILL_ME          # sbatch --partition (a CPU partition; no GPU is requested)
SLURM_QOS=                       # optional sbatch --qos; leave empty if your site does not use it
REPO_DIR=FILL_ME                 # absolute path of the cloned repository (the directory holding ewald_longitudinal/)
RUN_ROOT=FILL_ME                 # absolute path for run outputs (scratch or project space with enough quota)
LOG_ROOT=FILL_ME                 # absolute path for Slurm stdout/stderr files
# Shell commands that make $PYTHON usable on a compute node, e.g.
#   PY_SETUP="module load python/3.11 && source $HOME/venvs/toy/bin/activate"
#   PY_SETUP="source $HOME/miniforge3/etc/profile.d/conda.sh && conda activate toy"
PY_SETUP="FILL_ME"
PYTHON=python3
